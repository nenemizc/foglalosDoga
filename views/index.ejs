<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Szállás foglalós
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Szállás foglalós dolog</h1>
    <form method="post">
        <label>
            Név: <br> <input type="text" name="name" id="name" required value="<%= locals.formData?.name ?? '' %>">
        </label><br>
        <label>
            Email: <br> <input type="text" name="email" id="email" required value="<%= locals.formData?.email ?? '' %>">
        </label><br>
        <label>
            Kezdés dátuma: <br> <input type="datetime-local" name="startDate" id="startDate" required value="<%= locals.formData?.startDate ?? '' %>">
        </label><br>
        <label>
            Résztvevők száma: <br> <input type="number" min=1 max=10 name="guests" id="guests" required value="<%= locals.formData?.guests ?? '' %>">
        </label><br>
        <button type="submit">Küldés</button>
        <% if (locals.error) { %>
            <p> <%= locals.error %></p>
        <% } %>
    </form>
    
</body>
</html>